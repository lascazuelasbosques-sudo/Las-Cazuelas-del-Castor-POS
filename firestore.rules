rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: name (string), email (string), role (string), active (bool)
    //
    // Collection: categories
    // Fields: name (string), order (number)
    //
    // Collection: products
    // Fields: name (string), price (number), categoryId (string), stock (number), available (bool)
    //
    // Collection: orders
    // Fields: tableNumber (string), status (string), items (list), total (number), createdAt (timestamp), waiterId (string)
    //
    // Collection: cashLogs
    // Fields: type (string), amount (number), timestamp (timestamp), userId (string)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "lascazuelasbosques@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role) ||
        (exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return isEmailAdmin() || hasRole('admin');
    }

    // Staff can be identified by being authenticated (even anonymously)
    function isStaff() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role']) &&
             data.name is string && data.name.size() < 100 &&
             data.role in ['admin', 'waiter', 'kitchen', 'cashier', 'parrilla'];
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isStaff() && isValidUser(request.resource.data) && (
        request.auth.uid == userId || isAdmin()
      );
      
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) && (
        // Prevent changing your own role if not admin
        (isAdmin()) || (incoming().role == existing().role)
      );
      
      allow delete: if isAdmin() && userId != request.auth.uid; // Prevent self-deletion
    }

    match /test/connection {
      allow read: if true;
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{prodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /cashLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin() || hasRole('cashier');
      allow delete: if isAdmin();
    }

    match /cashAudits/{auditId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin() || hasRole('cashier');
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == sessionId || isAdmin());
      allow delete: if isAdmin();
    }

    // Add transactions match just in case it's used as a collection
    match /transactions/{id} {
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tipLoans/{loanId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if true;
    }

    match /walkieMessages/{msgId} {
      allow read, write: if true;
    }
  }
}
